---
import '../styles/global.css';
import { NAV, SITE_DESCRIPTION, SITE_TITLE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE_DESCRIPTION, image } = Astro.props;
const fullTitle = title ? `${title} - ${SITE_TITLE}` : `${SITE_TITLE} - ${SITE_DESCRIPTION}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/wp-content/uploads/2012/10/cropped-logonotext-32x32.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2012/10/cropped-logonotext-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2012/10/cropped-logonotext-180x180.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,700;1,400&family=Raleway:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="page">
      <a class="skip-link" href="#primary">Skip to content</a>
      <header class="site-header">
        <p class="site-title"><a href="/" rel="home">{SITE_TITLE}</a></p>
        <p class="site-description">{SITE_DESCRIPTION}</p>
        <nav aria-label="Main menu">
          <ul>
            {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </header>
      <slot name="hero" />
      <main id="primary">
        <slot />
      </main>
      <footer class="site-footer">
        Copyright &copy; {new Date().getFullYear()} <a href="/">{SITE_TITLE}</a>. All Rights Reserved.
      </footer>
    </div>

    <dialog id="lightbox" aria-label="Image viewer">
      <form method="dialog"><button aria-label="Close">&times;</button></form>
      <img alt="" />
    </dialog>
    <script>
      // Open linked full-size images in a dialog instead of navigating away.
      const dialog = document.getElementById('lightbox') as HTMLDialogElement;
      const full = dialog.querySelector('img')!;
      document.addEventListener('click', (event) => {
        const link = (event.target as Element).closest('a');
        if (!link?.querySelector('img') || !/\.(jpe?g|png|gif|webp)$/i.test(link.pathname)) return;
        event.preventDefault();
        full.src = link.href;
        full.alt = link.querySelector('img')!.alt;
        dialog.showModal();
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog || event.target === full) dialog.close();
      });
    </script>
  </body>
</html>
