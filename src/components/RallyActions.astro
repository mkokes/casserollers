---
// Register / calendar / Facebook event buttons for a rally that hasn't finished.
import Icon from './Icon.astro';
import { rallyIcs, type Rally } from '../lib/site';

interface Props {
  rally: Rally;
  details?: boolean;
}

const { rally, details = false } = Astro.props;
const { registerUrl, facebookEvent } = rally.data.rally;
---

<div class="rally-actions">
  {
    registerUrl ? (
      <a class="button button-big" href={registerUrl}>Register now</a>
    ) : (
      <span class="button button-big button-disabled" aria-disabled="true">Registration opens soon</span>
    )
  }
  <a class="button button-outline" href={rallyIcs(rally)} download>
    <Icon name="calendar" size={18} /> Add to calendar
  </a>
  {
    facebookEvent && (
      <a class="button button-outline" href={facebookEvent}>
        <Icon name="facebook" size={18} /> Facebook event
      </a>
    )
  }
  {details && <a class="button button-outline" href={rally.data.path}>Rally details</a>}
</div>
