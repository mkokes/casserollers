---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, paginate } from '../../lib/site';

export async function getStaticPaths() {
  return paginate(await getPosts(), '/')
    .slice(1)
    .map((p) => ({ params: { page: String(p.page) }, props: p }));
}

const { page, items, prev, next } = Astro.props;
---

<Base title={`Page ${page}`}>
  <PostList posts={items} prev={prev} next={next} />
</Base>
