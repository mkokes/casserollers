---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import SocialHero from '../components/SocialHero.astro';
import NextRally from '../components/NextRally.astro';
import WeeklyRide from '../components/WeeklyRide.astro';
import { getPosts, paginate } from '../lib/site';

const [first] = paginate(await getPosts(), '/');
---

<Base wide>
  <section slot="hero" class="intro">
    <h1>Minneapolis' Premier Vintage Moped Club</h1>
    <p>Weekly rides, fix-it sessions, rallies and races all over the Twin Cities.</p>
  </section>

  <SocialHero />
  <div class="home-row">
    <NextRally />
    <WeeklyRide />
  </div>

  <section class="home-posts" aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="section-title">Latest from the garage</h2>
    <PostList posts={first.items} next={first.next} />
  </section>
</Base>
